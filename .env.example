# Copy to .env to override defaults. docker compose reads .env automatically;
# every value below already has a working default in docker-compose.yml.

# Postgres credentials (used by the postgres container and all services)
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fraud_db

# Only needed when running services outside Docker:
# DATABASE_URL=postgresql://fraud_user:change-me@localhost:5432/fraud_db
# REDIS_URL=redis://localhost:6379/0
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
